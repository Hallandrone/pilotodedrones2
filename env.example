# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App Configuration
VITE_APP_NAME=Piloto de Drones
# En desarrollo local: http://localhost:8081
# En producción: https://app.pilotodedrones.cl
VITE_APP_URL=http://localhost:8081
VITE_APP_VERSION=1.0.0

# Developer Information
VITE_DEVELOPER_NAME=Alvaro Cofré
VITE_DEVELOPER_WEBSITE=https://www.alvarocofre.dev
VITE_DEVELOPER_EMAIL=web@alvarocofre.dev

# Flow Payments (Sandbox/Producción)
# Para sandbox usa las llaves de https://sandbox.flow.cl/app/web/misDatos.php
# Para producción usa las de https://www.flow.cl/app/web/misDatos.php
VITE_FLOW_ENV=sandbox
FLOW_API_BASE_SANDBOX=https://sandbox.flow.cl/api
FLOW_API_BASE_PRODUCTION=https://www.flow.cl/api
FLOW_API_KEY=your_flow_api_key_here
FLOW_SECRET_KEY=your_flow_secret_key_here
FLOW_WEBHOOK_SECRET=replace_with_random_string_for_webhook_validation

# Reveniu Subscriptions (Sandbox/Producción)
# Obtén tus credenciales en https://reveniu.com/ o el ambiente sandbox
# Para sandbox: crea una cuenta en el ambiente sandbox y genera tu API key
# Para producción: usa las credenciales de tu cuenta de producción
REVENIU_ENV=sandbox
REVENIU_API_KEY=your_reveniu_api_key_here
REVENIU_WEBHOOK_SECRET=replace_with_random_string_for_webhook_validation
